# openGym — standalone web server: serves the static app AND proxies /api to the backend,
# so the whole app lives on ONE origin (required for WebAuthn / passkeys).
server {
    listen ${NGINX_PORT};
    root /usr/share/nginx/html;
    index index.html;

    # Sent on every response below. NOTE: an `add_header` inside a location replaces the whole
    # inherited set rather than adding to it, so the two locations further down that set their
    # own Cache-Control have to repeat these three. Deliberately not a full Content-Security-
    # Policy: only frame-ancestors, which no part of the app depends on. TLS, HSTS and any
    # stricter policy stay the reverse proxy's job (see SECURITY.md).
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;
    add_header Content-Security-Policy "frame-ancestors 'none'" always;

    # Internal DNS resolvers only: host system DNS (via entrypoint), Railway private DNS, and Docker DNS
    resolver ${NGINX_LOCAL_RESOLVERS} [fd12::10] 127.0.0.11 valid=5s ipv6=on;

    # API → backend container.
    # Dynamic DNS resolution via Nginx variable prevents caching stale IP addresses.
    location ^~ /api/ {
        set $backend_upstream "${BACKEND}:${BACKEND_PORT}";
        proxy_pass http://$backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header CF-Connecting-IP "${CF_CONNECTING_IP}";
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    location /debug-backend {
        default_type text/plain;
        return 200 "BACKEND='${BACKEND}' BACKEND_PORT='${BACKEND_PORT}' PORT='${PORT}' NGINX_PORT='${NGINX_PORT}'\n";
    }

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }

    # App shell: always revalidate so updates show up immediately
    location ~* \.(js|css|json|html)$ {
        add_header Cache-Control "no-cache, must-revalidate";
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "same-origin" always;
        add_header Content-Security-Policy "frame-ancestors 'none'" always;
    }

    # Exercise images/GIFs never change → cache hard
    location ~* \.(png|jpg|jpeg|gif|ico|svg|woff|woff2|webp|avif)$ {
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "same-origin" always;
        add_header Content-Security-Policy "frame-ancestors 'none'" always;
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;
    gzip_vary on;
    gzip_min_length 1024;
}
